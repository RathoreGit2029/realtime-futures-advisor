{
  "manifest_version": 3,
  "name": "Binance Futures Real-Time Advisor",
  "version": "1.13.0",
  "description": "Real-time SMC & indicator-based trading HUD overlay for Binance Futures (USDⓈ-M). Zero-GPU, ultra-low latency.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://binance.com/*",
    "https://*.binance.com/*",
    "https://binance.me/*",
    "https://*.binance.me/*",
    "https://binance.info/*",
    "https://*.binance.info/*",
    "https://binancefuture.com/*",
    "https://*.binancefuture.com/*",
    "https://binance.us/*",
    "https://*.binance.us/*",
    "https://fapi.binance.com/*",
    "https://api.binance.com/*",
    "https://data-api.binance.vision/*",
    "https://api.allorigins.win/*",
    "http://localhost:4000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://binance.com/*",
        "https://*.binance.com/*",
        "https://binance.me/*",
        "https://*.binance.me/*",
        "https://binance.info/*",
        "https://*.binance.info/*",
        "https://binancefuture.com/*",
        "https://*.binancefuture.com/*",
        "https://binance.us/*",
        "https://*.binance.us/*"
      ],
      "js": ["content.js"],
      "css": ["hud.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hud.css"],
      "matches": [
        "https://binance.com/*",
        "https://*.binance.com/*"
      ]
    }
  ]
}
